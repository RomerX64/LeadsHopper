{
  "name": "leadhopper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm dev:infra && concurrently --kill-others --names api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:infra": "docker compose --profile core up -d postgres redis",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v && pnpm dev",
    "dev:logs": "docker compose logs -f",
    "build": "nx run-many -t build --all",
    "build:affected": "nx affected -t build --base=develop",
    "typecheck": "nx run-many -t typecheck --all",
    "typecheck:affected": "nx affected -t typecheck --base=develop",
    "lint": "nx run-many -t lint --all",
    "lint:affected": "nx affected -t lint --base=develop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:all",
    "test:all": "nx run-many -t test --all",
    "test:affected": "nx affected -t test --base=develop",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "nx run-many -t test --all --watch",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:all && pnpm build",
    "graph": "nx graph",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.1",
    "@eslint/js": "^9.17.0",
    "@nestjs/testing": "^12.0.1",
    "@nx/eslint": "^20.3.3",
    "@nx/js": "^20.3.3",
    "@nx/next": "^20.3.3",
    "@nx/node": "^20.3.3",
    "@nx/workspace": "^20.3.3",
    "@playwright/test": "^1.49.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^15.2.11",
    "nx": "^20.3.3",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
