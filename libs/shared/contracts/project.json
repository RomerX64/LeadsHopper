{
  "name": "shared-contracts",
  "sourceRoot": "libs/shared/contracts/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/libs/shared/contracts",
        "main": "libs/shared/contracts/src/index.ts",
        "tsConfig": "libs/shared/contracts/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p libs/shared/contracts/tsconfig.lib.json" }
    }
  },
  "tags": ["scope:shared", "type:contract"]
}
