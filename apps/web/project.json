{
  "name": "web",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "options": { "root": "apps/web", "outputPath": "dist/apps/web" }
    },
    "serve": {
      "executor": "@nx/next:server",
      "options": { "buildTarget": "web:build", "dev": true, "port": 3000 }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/web/tsconfig.json" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS=--experimental-vm-modules jest --config apps/web/jest.config.mjs --runInBand"
      }
    }
  },
  "tags": ["scope:web", "type:app"]
}
